# ELF Trading App — environment template. Copy to .env and fill in. NEVER commit .env.

# HTTP port for the API + web server
ELF_PORT=8787
# Directory for the SQLite database, secret key file and candle cache
ELF_DATA_DIR=./data

# 32-byte hex key used to encrypt stored provider credentials (AES-256-GCM).
# If unset, a random key is generated once and stored at $ELF_DATA_DIR/secret.key (mode 600).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELF_SECRET_KEY=

# Optional single-user password. When set, every /api route requires login.
# STRONGLY recommended whenever the app is reachable from the internet.
ELF_APP_PASSWORD=

# Provider credentials may be entered in the app (Market Data Providers page, stored encrypted
# server-side) OR supplied here. Environment values take precedence over stored values.
# Use read-only / market-data-only keys. Never enable withdrawals or trading permissions.
OANDA_API_TOKEN=
# practice | live  (which OANDA REST host to use)
OANDA_ENVIRONMENT=practice
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex (free) | sip (paid subscription)
ALPACA_DATA_FEED=iex

# Behind an HTTPS proxy (e.g. corporate/sandbox) set NODE_USE_ENV_PROXY=1 (Node >= 22.21)
# NODE_USE_ENV_PROXY=1
